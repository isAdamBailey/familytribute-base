APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=familytribute_base
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Sanctum SPA auth for the Nuxt frontend (frontend/). Leave blank for
# same-origin production (Nuxt and this API served from one host behind
# nginx); fill in when running Nuxt on a separate origin (local dev, CI).
SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=
FRONTEND_URLS=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=ses
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
# Recipient for scheduled-command failure emails (see App\Console\Kernel). Not
# a user-facing address. Leave blank to skip these notifications entirely.
MAIL_ADMIN_EMAIL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX) for this site. Served to the
# Nuxt frontend via GET /api/site-settings, and only when APP_ENV=production —
# leave blank to run without analytics.
GOOGLE_SITE_TAG=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
