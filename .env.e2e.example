APP_NAME="Family Tribute"
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
# "localhost", not 127.0.0.1: cookies are host-exact, and this must match the
# host the Nuxt frontend (below) is reached on in the browser — Playwright's
# webServer config (playwright.config.ts) always runs the API and Nuxt on
# these fixed ports, so these are static rather than computed at boot.
APP_URL=http://localhost:8000

# Trust the Nuxt origin as a stateful SPA.
FRONTEND_URLS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=array
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

E2E_HELPERS=true
